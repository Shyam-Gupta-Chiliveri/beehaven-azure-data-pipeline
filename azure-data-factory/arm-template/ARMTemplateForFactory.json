                                            "typeConversion": true,
                                            "typeConversionSettings": {
                                                "allowDataTruncation": true,
                                                "treatBooleanAsNumber": false
                                            }
                                        }
                                    },
                                    "inputs": [
                                        {
                                            "referenceName": "LakeMedallionBronzeNew",
                                            "type": "DatasetReference",
                                            "parameters": {}
                                        }
                                    ],
                                    "outputs": [
                                        {
                                            "referenceName": "Bronze_Archive",
                                            "type": "DatasetReference",
                                            "parameters": {
                                                "folder_name": {
                                                    "value": "@concat('bronze/archive/', \nsplit(item().name, '_')[0])",
                                                    "type": "Expression"
                                                },
                                                "file_name": {
                                                    "value": "@concat(\n    split(split(item().name, '_')[1], '.')[0],\n    '_',\n    utcNow('yyyy-MM-ddTHH''h''mm''m''ss''s'''),\n    '.csv')",
